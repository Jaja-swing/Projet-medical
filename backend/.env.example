# --- Application ---
PORT=3000

# --- Base de donnees PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=medical_appointments

# Synchronisation automatique du schema (developpement uniquement)
DB_SYNCHRONIZE=true

# --- Authentification JWT ---
JWT_SECRET=change-me-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# --- CORS ---
CORS_ORIGIN=http://localhost:5173
