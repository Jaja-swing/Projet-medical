{
  "name": "@medical/frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Interface React du systeme de gestion des rendez-vous medicaux",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js",
